{
  "name": "club-activity-system",
  "version": "1.0.0",
  "description": "Activity management system for The Aids Challenge Youth Club (Google Sheets or SQLite storage, zero dependencies, Node 22+)",
  "private": true,
  "scripts": {
    "start": "node src/club.js",
    "seed": "node scripts/seed.js",
    "test": "node --no-warnings --test --test-timeout=20000 test/api.test.js test/sheets.test.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "sheets:import": "node --no-warnings scripts/sheets-import.js",
    "e2e": "node --no-warnings e2e/run.js",
    "create-admin": "node --no-warnings scripts/create-admin.js"
  },
  "engines": {
    "node": "22.x"
  }
}